---
import BilingualText from './BilingualText.astro';

interface Props {
    title_en: string;
    title_te: string;
    price: string;
    mileage: string;
    image: string;
    slug: string;
    category: string;
}

const { title_en, title_te, price, mileage, image, slug, category } = Astro.props;
---
<!-- Honda's card language: 24px corners, hairline border, flat — no elevation on hover. -->
<a href={`/products/${slug}/`} class="group bg-white rounded-2xl overflow-hidden transition-colors duration-300 border border-gray-200 hover:border-red-600 flex flex-col">
  <div class="relative aspect-[4/3] overflow-hidden bg-gray-50">
    <div class="absolute top-4 left-4 bg-white text-xs font-medium px-3 py-1 rounded-pill text-black z-10">
      {category}
    </div>
    <img src={image} alt={`${title_en} — Sairam Honda Nizamabad`} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
  </div>

  <div class="p-6 flex-1 flex flex-col">
    <div class="mb-1">
      <h2 class="text-h-sm font-semibold text-black">{title_en}</h2>
      <p class="text-sm text-gray-600 font-noto">{title_te}</p>
    </div>

    <div class="mt-4 flex items-center gap-4 text-sm text-gray-600 mb-4">
       <span>{mileage}</span>
       <span class="font-semibold text-black">
         {price}
       </span>
    </div>

    <div class="mt-auto pt-4 border-t border-gray-200">
      <span class="text-sm font-semibold text-red-600 group-hover:text-red-700">View Details &rarr;</span>
    </div>
  </div>
</a>
