---
---
<!-- Honda's corporate header: solid white, 78px, no rule beneath it. -->
<nav class="fixed w-full bg-white z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-[78px] items-center">

      <!-- Logo — compact, no "Authorized Honda Dealer" tag -->
      <a href="/" class="flex-shrink-0 group">
        <div class="flex flex-col">
          <span class="text-xl font-semibold tracking-tight text-red-600 group-hover:opacity-90 transition">
            Sairam Honda
          </span>
          <span class="text-xs text-gray-600 font-noto">
            సాయిరామ్ హోండా • నిజామాబాద్
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex space-x-8 items-center">
        <a href="/products/" class="flex flex-col items-start hover:opacity-70 transition-opacity">
          <span class="text-sm font-bold text-gray-900">Bikes & Scooters</span>
          <span class="text-xs text-gray-600 font-noto">బైకులు & స్కూటర్లు</span>
        </a>
        <a href="/branches/" class="flex flex-col items-start hover:opacity-70 transition-opacity">
          <span class="text-sm font-bold text-gray-900">Branches</span>
          <span class="text-xs text-gray-600 font-noto">బ్రాంచ్‌లు</span>
        </a>
        <a href="/service/" class="flex flex-col items-start hover:opacity-70 transition-opacity">
          <span class="text-sm font-bold text-gray-900">Service</span>
          <span class="text-xs text-gray-600 font-noto">సర్వీస్</span>
        </a>
        <a href="/blog/" class="flex flex-col items-start hover:opacity-70 transition-opacity">
          <span class="text-sm font-bold text-gray-900">Blog</span>
          <span class="text-xs text-gray-600 font-noto">బ్లాగ్</span>
        </a>
        <a href="https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20know%20about%20Honda%20bikes%20and%20scooters.%20%5BW-SH%5D"
           class="bg-red-600 text-white px-8 py-3 rounded-pill text-base font-semibold hover:bg-red-700 transition flex items-center gap-2">
          <span>Enquire</span>
          <span class="font-noto text-xs opacity-80">విచారించండి</span>
        </a>
      </div>

      <!-- Mobile: Enquire button + Hamburger -->
      <div class="flex md:hidden items-center gap-2">
        <a href="https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20know%20about%20Honda%20bikes.%20%5BW-SH%5D"
           class="bg-red-600 text-white px-5 py-2.5 rounded-pill text-sm font-semibold hover:bg-red-700 transition">
          Enquire
        </a>
        <button id="mobile-menu-btn" aria-label="Open menu"
                class="p-2 rounded-lg text-gray-700 hover:bg-gray-100 transition">
          <!-- Hamburger icon -->
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close icon (hidden by default) -->
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white shadow-lg">
    <div class="px-4 py-4 space-y-1">
      <a href="/products/"
         class="flex items-center justify-between px-4 py-3 rounded-lg hover:bg-red-50 transition group">
        <div>
          <span class="block text-sm font-bold text-gray-900 group-hover:text-red-600">Bikes & Scooters</span>
          <span class="block text-xs text-gray-600 font-noto">బైకులు & స్కూటర్లు</span>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 group-hover:text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
      <a href="/branches/"
         class="flex items-center justify-between px-4 py-3 rounded-lg hover:bg-red-50 transition group">
        <div>
          <span class="block text-sm font-bold text-gray-900 group-hover:text-red-600">Our 7 Branches</span>
          <span class="block text-xs text-gray-600 font-noto">మా 7 బ్రాంచ్‌లు</span>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 group-hover:text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
      <a href="/service/"
         class="flex items-center justify-between px-4 py-3 rounded-lg hover:bg-red-50 transition group">
        <div>
          <span class="block text-sm font-bold text-gray-900 group-hover:text-red-600">Service Centre</span>
          <span class="block text-xs text-gray-600 font-noto">సర్వీస్ సెంటర్</span>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 group-hover:text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
      <a href="/blog/"
         class="flex items-center justify-between px-4 py-3 rounded-lg hover:bg-red-50 transition group">
        <div>
          <span class="block text-sm font-bold text-gray-900 group-hover:text-red-600">Blog & Tips</span>
          <span class="block text-xs text-gray-600 font-noto">బ్లాగ్ & చిట్కాలు</span>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 group-hover:text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
      <!-- Mobile CTA -->
      <div class="pt-2 pb-1">
        <a href="https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20know%20about%20Honda%20bikes%20and%20scooters.%20%5BW-SH%5D"
           class="flex items-center justify-center gap-2 w-full bg-red-600 text-white px-4 py-3 rounded-pill font-bold text-sm hover:bg-red-700 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span>WhatsApp Enquiry</span>
          <span class="font-noto text-xs opacity-80">విచారించండి</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
  });

  // Close menu when a link is tapped
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
