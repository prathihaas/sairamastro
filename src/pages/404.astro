---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Sairam Honda Nizamabad"
  description="The page you're looking for doesn't exist. Find Honda bikes, scooters, branch locations and service info at Sairam Honda Nizamabad."
  canonical="https://www.sairamhonda.com/404/"
>
  <main class="max-w-3xl mx-auto px-4 py-24 text-center">
    <div class="mb-8">
      <span class="text-8xl font-semibold text-red-100">404</span>
    </div>
    <h1 class="text-3xl font-semibold text-gray-900 mb-3">Page Not Found</h1>
    <p class="text-gray-500 font-noto text-lg mb-2">పేజీ కనుగొనబడలేదు</p>
    <p class="text-gray-600 mb-10 max-w-md mx-auto">The page you're looking for doesn't exist or may have moved. Try one of the links below.</p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
      <a href="/" class="inline-flex items-center justify-center gap-2 bg-red-600 text-white px-6 py-3 rounded-pill font-bold hover:bg-red-700 transition">
         Back to Home
      </a>
      <a href="/products/" class="inline-flex items-center justify-center gap-2 border border-red-600 text-red-600 px-6 py-3 rounded-pill font-bold hover:bg-red-50 transition">
         Browse Honda Models
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
      <a href="/branches/" class="block p-5 rounded-2xl border border-gray-200 hover:border-red-300 hover:bg-red-50 transition">
        <div class="text-2xl mb-2"></div>
        <div class="font-bold text-gray-900 text-sm">Find a Branch</div>
        <div class="text-xs text-gray-500 mt-1">7 showrooms across Nizamabad district</div>
      </a>
      <a href="/service/" class="block p-5 rounded-2xl border border-gray-200 hover:border-red-300 hover:bg-red-50 transition">
        <div class="text-2xl mb-2"></div>
        <div class="font-bold text-gray-900 text-sm">Service Centre</div>
        <div class="text-xs text-gray-500 mt-1">Honda authorized service, genuine parts</div>
      </a>
      <a href="/blog/" class="block p-5 rounded-2xl border border-gray-200 hover:border-red-300 hover:bg-red-50 transition">
        <div class="text-2xl mb-2"></div>
        <div class="font-bold text-gray-900 text-sm">Honda Guides</div>
        <div class="text-xs text-gray-500 mt-1">Buying guides, comparisons, tips</div>
      </a>
    </div>

    <div class="bg-gray-900 rounded-2xl p-6 text-white">
      <p class="font-bold mb-4">Can't find what you need? Call or WhatsApp us:</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="tel:+918886640573" class="inline-flex items-center justify-center gap-2 bg-red-600 px-5 py-3 rounded-pill font-bold hover:bg-red-700 transition">
           8886640573
        </a>
        <a href="https://wa.me/919666679377?text=Hi%20Sairam%20Honda%2C%20I%20need%20help%20finding%20information.%20%5BW-404%5D"
           target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center justify-center gap-2 bg-green-600 px-5 py-3 rounded-pill font-bold hover:bg-[#20bd5a] transition">
           WhatsApp Us
        </a>
      </div>
    </div>
  </main>
</Layout>
