---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const branches = await getCollection('branches');

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sairamhonda.com/" },
    { "@type": "ListItem", "position": 2, "name": "All Branches", "item": "https://www.sairamhonda.com/branches/" }
  ]
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Sairam Honda — All 7 Branch Locations in Nizamabad District",
  "description": "Find all 7 Sairam Honda authorized Honda dealerships across Nizamabad district, Telangana.",
  "url": "https://www.sairamhonda.com/branches/",
  "numberOfItems": 7,
  "itemListElement": branches.map((branch, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `https://www.sairamhonda.com/branches/${branch.slug}/`,
    "name": branch.data.name_en
  }))
};
---

<Layout
  title="All Sairam Honda Branches in Nizamabad | 7 Honda Showrooms"
  description="All 7 Sairam Honda showrooms across Nizamabad district — Nizamabad, Armoor, Bodhan, Dichpally, Dharpally, Nandipet & Bichkunda. Address, phone & directions."
  canonical="https://www.sairamhonda.com/branches/"
  noOrgSchema={true}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <div class="pt-28 pb-6 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4">
      <nav class="text-sm text-gray-500 mb-4 flex items-center gap-2">
        <a href="/" class="text-red-600 hover:underline font-semibold">Home</a>
        <span>›</span>
        <span class="text-gray-700 font-medium">All Branches</span>
      </nav>

      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-700 mb-4">
          <span class="text-xs font-bold uppercase tracking-wider">Authorized Honda Dealer — 7 Locations</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-black text-gray-900 mb-3">Sairam Honda Branches</h1>
        <p class="text-xl text-gray-500 font-noto mb-2">నిజామాబాద్ జిల్లాలో మా 7 షోరూమ్‌లు</p>
        <p class="text-gray-600 max-w-2xl mx-auto">7 authorized Honda showrooms across Nizamabad district — find your nearest branch for the best price, test ride, and service.</p>
      </div>

      <!-- Branch Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        {branches.map((branch) => {
          const cityName = branch.data.address_en.split(',').pop()?.trim() ?? 'Nizamabad';
          return (
            <a href={`/branches/${branch.slug}/`}
              class="group bg-white rounded-2xl border border-gray-200 p-6 hover:border-red-300 hover:shadow-lg transition-all duration-200 block">
              <div class="flex items-start justify-between mb-3">
                <div>
                  <h2 class="text-xl font-bold text-gray-900 group-hover:text-red-600 transition">{branch.data.name_en}</h2>
                  <p class="text-sm text-gray-500 font-noto">{branch.data.name_te}</p>
                </div>
                <span class="text-red-500 text-lg group-hover:translate-x-1 transition-transform">→</span>
              </div>

              <p class="text-gray-600 text-sm leading-relaxed mb-1">{branch.data.address_en}</p>
              <p class="text-xs text-gray-400 font-noto mb-4">{branch.data.address_te}</p>

              <div class="flex items-center gap-2 mb-5">
                <span class="text-xs text-gray-500">📞</span>
                <span class="font-bold text-gray-900 text-sm">{branch.data.phone}</span>
                <span class="text-xs text-gray-400 ml-auto">Mon–Sat, 9AM–7PM</span>
              </div>

              <div class="grid grid-cols-3 gap-2" onclick="event.preventDefault()">
                <a href={`tel:${branch.data.phone.replace(/\s/g, '')}`}
                  class="flex items-center justify-center gap-1 bg-red-600 text-white rounded-lg py-2 font-bold text-xs hover:bg-red-700 transition"
                  onclick="event.stopPropagation()">
                  📞 Call
                </a>
                <a href={branch.data.map_link} target="_blank" rel="noopener noreferrer"
                  class="flex items-center justify-center gap-1 border border-gray-200 rounded-lg py-2 font-semibold text-xs hover:bg-gray-50 transition text-gray-700"
                  onclick="event.stopPropagation()">
                  🗺️ Directions
                </a>
                <a href={`https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20visit%20Sairam%20Honda%20${encodeURIComponent(branch.data.name_en)}.%20%5BW-BR%5D`}
                  target="_blank" rel="noopener noreferrer"
                  class="flex items-center justify-center gap-1 bg-green-50 text-green-700 border border-green-200 rounded-lg py-2 font-bold text-xs hover:bg-green-100 transition"
                  onclick="event.stopPropagation()">
                  💬 WhatsApp
                </a>
              </div>
            </a>
          );
        })}
      </div>

      <!-- Service Area -->
      <div class="bg-red-50 rounded-2xl p-8 mb-10 text-center">
        <h2 class="text-2xl font-black text-gray-900 mb-3">Serving All of Nizamabad District</h2>
        <p class="text-gray-600 mb-5">Our 7-branch network covers every mandal in Nizamabad district. No Honda owner has to travel far for sales, service, or genuine spare parts.</p>
        <div class="flex flex-wrap justify-center gap-2">
          {[
            "Nizamabad", "Armoor", "Bodhan", "Dichpally", "Dharpally", "Nandipet", "Bichkunda",
            "Balkonda", "Banswada", "Yellareddy", "Bheemgal", "Rudrur", "Varni", "Indalwai",
            "Jakranpally", "Renjal", "Lingampet", "Nizamsagar", "Yellareddy", "Kotagiri"
          ].map(area => (
            <span class="bg-white text-red-700 border border-red-200 px-3 py-1 rounded-full text-sm font-semibold">{area}</span>
          ))}
        </div>
      </div>

      <!-- CTA -->
      <div class="bg-gray-900 text-white rounded-2xl p-8 text-center">
        <h2 class="text-2xl font-black mb-2">Not Sure Which Branch to Visit?</h2>
        <p class="text-gray-300 mb-6">Call or WhatsApp us — we'll guide you to the nearest Sairam Honda showroom and confirm today's best price on any Honda model.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:+918886640573"
            class="inline-flex items-center justify-center gap-2 bg-red-600 text-white px-7 py-3 rounded-xl font-bold text-lg hover:bg-red-700 transition">
            📞 Call 8886640573
          </a>
          <a href="https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20find%20the%20nearest%20Sairam%20Honda%20branch.%20%5BW-BR%5D"
            target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-green-600 text-white px-7 py-3 rounded-xl font-bold text-lg hover:bg-green-700 transition">
            💬 WhatsApp Us
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
