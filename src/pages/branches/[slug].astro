---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';


export async function getStaticPaths() {
  const branches = await getCollection('branches');
  return branches.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { name_en, name_te, address_en, address_te, phone, map_link, postalCode, geo, seo_title: fm_title, seo_description: fm_desc } = entry.data;

// Fetch blog posts related to this branch location
const allBlogPosts = await getCollection('blog', (post) => !post.data.draft);
const relatedPosts = allBlogPosts
  .filter(post => post.slug.includes(entry.slug) || post.data.title?.toLowerCase().includes(entry.slug))
  .slice(0, 4);

const cityName = address_en.split(',').pop()?.trim() ?? 'Nizamabad';
const seo_title = fm_title ?? `Honda Dealer in ${cityName} | Sairam Honda`;
const seo_description = fm_desc ?? `Sairam Honda ${cityName} — authorized Honda dealer for bikes & scooters. Test rides, easy EMI. Visit ${address_en}. Call ${phone}.`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sairamhonda.com/" },
    { "@type": "ListItem", "position": 2, "name": "Branches", "item": "https://www.sairamhonda.com/#branches" },
    { "@type": "ListItem", "position": 3, "name": `Sairam Honda ${cityName}`, "item": `https://www.sairamhonda.com/branches/${entry.slug}` }
  ]
};

// Branch-specific LocalBusiness schema for rich results
const branchSchema = {
  "@context": "https://schema.org",
  "@type": "AutoDealer",
  "@id": `https://www.sairamhonda.com/branches/${entry.slug}#branch`,
  "name": `Sairam Honda ${cityName}`,
  "description": `Authorized Honda two-wheeler dealership in ${cityName}, Nizamabad district. New Honda motorcycles and scooters, authorized service, genuine parts, easy EMI financing.`,
  "url": `https://www.sairamhonda.com/branches/${entry.slug}`,
  "telephone": phone,
  "brand": { "@type": "Brand", "name": "Honda" },
  "image": "https://www.sairamhonda.com/og-image.jpg",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": address_en,
    "addressLocality": cityName,
    "addressRegion": "Telangana",
    ...(postalCode && { "postalCode": postalCode }),
    "addressCountry": "IN"
  },
  ...(geo && { "geo": { "@type": "GeoCoordinates", "latitude": geo.lat, "longitude": geo.lng } }),
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
    "opens": "09:00",
    "closes": "19:00"
  }],
  "parentOrganization": {
    "@type": "AutoDealer",
    "@id": "https://www.sairamhonda.com/#dealer",
    "name": "Sairam Honda",
    "url": "https://www.sairamhonda.com"
  }
};
---

<Layout title={seo_title} description={seo_description}>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(branchSchema)} />

  <main class="max-w-4xl mx-auto px-4 py-16">

    <!-- Back navigation -->
    <a href="/#branches" class="inline-flex items-center gap-2 text-red-600 font-semibold mb-8 hover:text-red-700 transition">
      ← All Branches / అన్ని బ్రాంచ్‌లు
    </a>

    <!-- Branch Header -->
    <header class="mb-10 border-b border-gray-100 pb-10">
      <h1 class="text-4xl font-black tracking-tight text-gray-900">Honda Dealer in {cityName} — Sairam Honda</h1>
      <h2 class="text-2xl text-gray-500 font-noto font-medium mt-2">{name_te}</h2>
    </header>

    <!-- Contact Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">

      <!-- Address -->
      <div class="bg-gray-50 rounded-2xl p-6">
        <h3 class="font-bold text-gray-800 text-sm uppercase tracking-wider mb-3">📍 Address / చిరునామా</h3>
        <p class="text-gray-700 font-medium text-lg">{address_en}</p>
        <p class="font-noto text-gray-500 mt-2 text-base">{address_te}</p>
      </div>

      <!-- Phone & Hours -->
      <div class="bg-gray-50 rounded-2xl p-6">
        <h3 class="font-bold text-gray-800 text-sm uppercase tracking-wider mb-3">📞 Contact / సంప్రదించండి</h3>
        <a href={`tel:${phone.replace(/\s/g, '')}`} class="text-red-600 font-bold text-xl hover:text-red-700 transition block">
          {phone}
        </a>
        <p class="text-gray-500 text-sm mt-2">Monday – Saturday, 9 AM – 7 PM</p>
        <p class="font-noto text-gray-500 text-sm">సోమవారం – శనివారం, ఉ.9 – సా.7</p>
      </div>
    </div>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 mb-14">
      <a
        href={`tel:${phone.replace(/\s/g, '')}`}
        class="flex-1 bg-red-600 text-white text-center py-4 rounded-xl font-bold text-lg hover:bg-red-700 transition shadow-lg shadow-red-100"
      >
        📞 Call Now
      </a>
      <a
        href={map_link}
        target="_blank" rel="noopener noreferrer"
        class="flex-1 border-2 border-red-600 text-red-600 text-center py-4 rounded-xl font-bold text-lg hover:bg-red-50 transition"
      >
        🗺️ Get Directions
      </a>
      <a
        href={`https://wa.me/919666679377?text=Hi, I want to visit Sairam Honda ${name_en}. [W-BR]`}
        target="_blank" rel="noopener noreferrer"
        class="flex-1 bg-green-600 text-white text-center py-4 rounded-xl font-bold text-lg hover:bg-green-700 transition"
      >
        💬 WhatsApp
      </a>
    </div>

    <!-- About This Branch -->
    <section class="mb-12">
      <h2 class="text-2xl font-black text-gray-900 mb-4">About Sairam Honda {cityName} Showroom</h2>
      <p class="text-gray-600 leading-relaxed mb-3">
        Sairam Honda {cityName} is your trusted authorized Honda two-wheeler dealership in {cityName}, Telangana.
        As part of Sairam Honda's 7-branch network across Nizamabad district, we bring Honda's full lineup
        — scooters, commuter bikes, and performance motorcycles — right to your doorstep.
      </p>
      <p class="text-gray-600 leading-relaxed mb-3">
        Our {cityName} showroom offers the complete Honda range including Honda Activa 110, Activa 125,
        Shine 125, SP 160, Unicorn, Dio, Livo, CB Hornet 125, Hornet 2.0, and CB200X.
        We provide test rides, transparent on-road pricing, easy EMI options through multiple finance partners,
        and Honda Genuine Accessories at our showroom.
      </p>
      <p class="text-gray-600 leading-relaxed">
        Our trained Honda service technicians are available Monday to Saturday to ensure your Honda
        stays in peak condition. Whether you need routine maintenance, genuine spare parts, or
        warranty service — Sairam Honda {cityName} has you covered.
      </p>
    </section>

    <!-- Popular Honda Models -->
    <section class="mb-12">
      <h2 class="text-2xl font-black text-gray-900 mb-6">Popular Honda Models at {cityName} Showroom</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {[
          { slug: "activa-125", name: "Honda Activa 125" },
          { slug: "activa-110", name: "Honda Activa 110" },
          { slug: "shine-125", name: "Honda Shine 125" },
          { slug: "sp-160", name: "Honda SP 160" },
          { slug: "unicorn", name: "Honda Unicorn" },
          { slug: "hornet-2-0", name: "Honda Hornet 2.0" },
          { slug: "dio-125", name: "Honda Dio 125" },
          { slug: "livo", name: "Honda Livo" },
          { slug: "cb200x", name: "Honda CB200X" },
        ].map(bike => (
          <a href={`/products/${bike.slug}`}
             class="flex items-center gap-2 p-3 rounded-xl border border-gray-100 hover:border-red-200 hover:bg-red-50 transition-all font-semibold text-sm text-gray-700 hover:text-red-600">
            <span class="text-red-500">→</span>
            {bike.name}
          </a>
        ))}
      </div>
      <p class="mt-4 text-sm text-gray-400">
        <a href="/products" class="text-red-600 font-bold hover:underline">View complete Honda lineup →</a>
      </p>
    </section>

    <!-- Google Maps Embed -->
    {geo && (
      <section class="mb-12">
        <h2 class="text-2xl font-black text-gray-900 mb-4">Find Us on Map</h2>
        <div class="rounded-2xl overflow-hidden shadow-md">
          <iframe
            width="100%"
            height="350"
            style="border:0"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src={`https://maps.google.com/maps?q=${geo.lat},${geo.lng}&z=15&output=embed`}
            title={`Sairam Honda ${cityName} location map`}
          ></iframe>
        </div>
        <p class="mt-3 text-sm text-gray-500">
          <a href={map_link} target="_blank" rel="noopener noreferrer" class="text-red-600 font-semibold hover:underline">
            Open in Google Maps →
          </a>
        </p>
      </section>
    )}

    <!-- Markdown Content (extra info per branch if any) -->
    <article class="prose max-w-none text-gray-700 mb-12">
      <Content />
    </article>

    <!-- Related Blog Posts -->
    {relatedPosts.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-black text-gray-900 mb-5">Honda Guides for {cityName} Riders</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedPosts.map(post => (
            <a href={`/blog/${post.slug}`}
               class="block p-5 rounded-xl border border-gray-200 hover:border-red-300 hover:bg-red-50 transition-all group">
              <div class="font-bold text-gray-900 group-hover:text-red-600 transition text-sm leading-snug">{post.data.title}</div>
              {post.data.excerpt && <div class="text-xs text-gray-500 mt-2 line-clamp-2">{post.data.excerpt}</div>}
            </a>
          ))}
        </div>
        <p class="mt-3 text-sm">
          <a href="/blog" class="text-red-600 font-bold hover:underline">Read all Honda guides →</a>
        </p>
      </section>
    )}

    <!-- Honda Products CTA -->
    <div class="bg-red-50 rounded-2xl p-8 text-center">
      <h3 class="text-2xl font-black text-gray-900 mb-2">Explore Honda Bikes & Scooters</h3>
      <p class="font-noto text-gray-600 mb-2">హోండా బైక్స్ మరియు స్కూటర్లు చూడండి</p>
      <p class="text-gray-500 mb-6">Available at all Sairam Honda showrooms across Nizamabad district.</p>
      <a href="/products" class="inline-block bg-red-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-red-700 transition">
        View All Products
      </a>
    </div>

  </main>
</Layout>
