---
import Layout from '../layouts/Layout.astro';

const RATING = "4.0";
const REVIEW_COUNT = "1159";

const reviewPageSchema = {
  "@context": "https://schema.org",
  "@type": "AutoDealer",
  "@id": "https://www.sairamhonda.com/#dealer",
  "name": "Sairam Honda",
  "url": "https://www.sairamhonda.com/",
  "telephone": "+91-8886640573",
  "brand": { "@type": "Brand", "name": "Honda" },
  "numberOfLocations": 7,
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": RATING,
    "reviewCount": REVIEW_COUNT,
    "bestRating": "5",
    "worstRating": "1"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sairamhonda.com/" },
    { "@type": "ListItem", "position": 2, "name": "Reviews", "item": "https://www.sairamhonda.com/reviews/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is Sairam Honda a good Honda dealer in Nizamabad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Sairam Honda holds a ${RATING} star rating from ${REVIEW_COUNT}+ Google reviews across its Nizamabad district branches. It has been an authorised Honda two-wheeler dealer since 2003 and operates 7 branches.`
      }
    },
    {
      "@type": "Question",
      "name": "How many branches does Sairam Honda have?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Seven — Nizamabad (main), Armoor, Bodhan, Dichpally, Dharpally, Nandipet and Bichkunda."
      }
    },
    {
      "@type": "Question",
      "name": "Where can I read Sairam Honda reviews?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Search for the branch by name on Google Maps to read verified customer reviews for that specific showroom. Ratings differ slightly between branches."
      }
    }
  ]
};

const branches = [
  { name: "Nizamabad (Main)", slug: "nizamabad" },
  { name: "Armoor", slug: "armoor" },
  { name: "Bodhan", slug: "bodhan" },
  { name: "Dichpally", slug: "dichpally" },
  { name: "Dharpally", slug: "dharpally" },
  { name: "Nandipet", slug: "nandipet" },
  { name: "Bichkunda", slug: "bichkunda" },
];
---

<Layout
  title="Sairam Honda Reviews | 4.0★ from 1,159+ Customers"
  description="Sairam Honda reviews — 4.0 stars from 1,159+ Google reviews across 7 Nizamabad district branches. What customers say, and how to leave your own review."
  canonical="https://www.sairamhonda.com/reviews/"
>
  <script type="application/ld+json" set:html={JSON.stringify(reviewPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="max-w-4xl mx-auto px-4 py-20 pt-32">

    <nav class="text-sm text-gray-400 mb-8 flex items-center gap-2 font-semibold">
      <a href="/" class="hover:text-red-600 transition">Home</a>
      <span>/</span>
      <span class="text-gray-700">Reviews</span>
    </nav>

    <h1 class="text-4xl font-black text-gray-900 mb-4">Sairam Honda Reviews</h1>

    <div class="flex items-baseline gap-4 mb-8">
      <span class="text-5xl font-black text-red-600">{RATING}</span>
      <div>
        <div class="text-yellow-500 text-2xl leading-none">★★★★☆</div>
        <p class="text-gray-600 text-sm mt-1">from {Number(REVIEW_COUNT).toLocaleString('en-IN')}+ Google reviews</p>
      </div>
    </div>

    <p class="text-gray-700 mb-6">
      Sairam Honda has been an authorised Honda two-wheeler dealer in Nizamabad district since 2003.
      Across our seven branches we currently hold a <strong>{RATING} star rating from {Number(REVIEW_COUNT).toLocaleString('en-IN')}+ Google reviews</strong>.
      That is a real number, not a marketing one — and it includes the customers who were unhappy with us.
    </p>

    <h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">What customers rate us on</h2>
    <ul class="space-y-2 text-gray-700 mb-6">
      <li>• <strong>Price transparency</strong> — the on-road breakup is shown before booking, not after</li>
      <li>• <strong>Delivery time</strong> — realistic dates, and a call if a model is short in stock</li>
      <li>• <strong>Service turnaround</strong> — free services stamped correctly so warranty stays valid</li>
      <li>• <strong>Genuine parts</strong> — HMSI parts only, part numbers shown on request</li>
    </ul>

    <h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Reviews by branch</h2>
    <p class="text-gray-700 mb-4">
      Ratings differ between branches. Search the branch by name on Google Maps to read verified reviews for that specific showroom:
    </p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-10">
      {branches.map((b) => (
        <a href={`/branches/${b.slug}/`} class="border border-gray-200 rounded-xl px-4 py-3 text-sm font-bold text-gray-800 hover:border-red-600 hover:text-red-600 transition">
          {b.name}
        </a>
      ))}
    </div>

    <h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Had a bad experience?</h2>
    <p class="text-gray-700 mb-6">
      Tell us before you tell Google — we would rather fix it. WhatsApp
      <a href="https://wa.me/919666679377?text=Hi%20Sairam%20Honda%2C%20I%20want%20to%20report%20an%20issue.%20%5BW-RV%5D" class="text-red-600 font-bold underline">9666679377</a>
      or call <a href="tel:+918886640573" class="text-red-600 font-bold underline">8886640573</a> and ask for the branch manager.
    </p>

    <div class="bg-gray-50 border border-gray-200 rounded-2xl p-8 text-center">
      <h2 class="text-xl font-black text-gray-900 mb-2">Leave a review</h2>
      <p class="text-gray-600 mb-6">Bought or serviced a Honda with us? A one-line review helps the next buyer more than any ad we could run.</p>
      <a href="/branches/" class="inline-flex items-center justify-center bg-red-600 text-white font-black px-8 py-3 rounded-xl hover:bg-red-700 transition uppercase tracking-wide">
        Find your branch
      </a>
    </div>

  </main>
</Layout>
