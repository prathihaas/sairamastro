        target="_blank" rel="noopener noreferrer"
        class="tap"
        style="display:inline-flex; gap:6px; border:1.5px solid #25D366; color:#16A34A; padding:10px 20px; border-radius:10px; font-weight:700; font-size:13px;">
        <span class="deco" aria-hidden="true">💬</span> Not sure which model? Ask us
      </a>
    </div>
  </section>

  <!-- EMI -->
  <section style="margin:0 16px 24px; max-width:568px; margin-left:auto; margin-right:auto;">
    <a href={waLink("Hi Sairam Honda, I want to check my Honda bike EMI eligibility. [W-LP-EMI]")}
      target="_blank" rel="noopener noreferrer"
      class="card"
