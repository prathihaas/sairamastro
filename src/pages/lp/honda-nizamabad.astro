<body>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TJXW67R9" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<div class="page-body">

  <!-- HEADER -->
  <header style="background:#DC2626; padding:10px 16px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:50;">
    <div style="display:flex; align-items:center; gap:10px; min-width:0;">
      <div style="width:36px; height:36px; background:white; color:#DC2626; border-radius:8px; display:flex; align-items:center; justify-content:center; font-weight:900; font-size:16px; flex-shrink:0;">SH</div>
      <div style="min-width:0;">
        <p style="color:white; font-weight:900; font-size:15px; line-height:1.1;">Sairam Honda</p>
        <p style="color:#fecaca; font-size:10px; line-height:1.1; margin-top:2px;">Authorized Honda Dealer · Nizamabad</p>
      </div>
    </div>
    <a href={`tel:${PHONE}`} class="tap" style="background:white; color:#DC2626; font-weight:800; font-size:13px; padding:0 14px; border-radius:8px; gap:5px; flex-shrink:0;">
      <span class="deco" aria-hidden="true">📞</span> Call
    </a>
  </header>

  <!-- INFO BAR -->
  <a href={waLink("Hi Sairam Honda, I want to know more about the exchange bonus. [W-LP-EXCH]")} target="_blank" rel="noopener noreferrer"
    style="display:block; background:#FEF9C3; border-bottom:1px solid #FDE68A; padding:10px 16px; text-align:center;">
    <p style="font-size:12px; font-weight:600; color:#713F12;">
      Honda exchange offer · Bring your old bike for a free valuation · Tap to ask on WhatsApp
    </p>
  </a>

  <!-- HERO -->
  <section style="background:linear-gradient(160deg, #fff 60%, #fff5f5 100%); padding:28px 16px 24px; text-align:center; max-width:600px; margin:0 auto;">

    <div style="display:inline-block; background:#DCFCE7; color:#166534; font-size:11px; font-weight:700; padding:5px 12px; border-radius:20px; margin-bottom:14px;">
      Authorized Honda Dealer · Since 2008
    </div>

    <h1 style="font-size:clamp(24px,6.5vw,34px); font-weight:900; line-height:1.15; color:#111; margin-bottom:8px;">
      Honda Bikes &amp; Scooters<br/>
      <span style="color:#DC2626;">in Nizamabad</span>
    </h1>

    <p lang="te" class="fn" style="color:#6B7280; font-size:14px; margin-bottom:6px;">
      నిజామాబాద్‌లో హోండా బైక్స్ — నేటి ధర కోసం కాల్ చేయండి
    </p>
    <p style="font-size:13px; color:#6B7280; margin-bottom:20px;">
      7 branches · EMI available · Free test ride · Exchange accepted
    </p>

    <!-- Social proof row -->
    <div style="display:flex; justify-content:center; gap:20px; flex-wrap:wrap; margin-bottom:24px;">
      <div style="text-align:center;">
        <p style="font-size:20px; font-weight:900; color:#DC2626; line-height:1;">4.0★</p>
        <p style="font-size:10px; color:#9CA3AF;">Google rating</p>
      </div>
      <div style="width:1px; background:#E5E7EB;"></div>
      <div style="text-align:center;">
        <p style="font-size:20px; font-weight:900; color:#DC2626; line-height:1;">1,159+</p>
        <p style="font-size:10px; color:#9CA3AF;">Google reviews</p>
      </div>
      <div style="width:1px; background:#E5E7EB;"></div>
      <div style="text-align:center;">
        <p style="font-size:20px; font-weight:900; color:#DC2626; line-height:1;">7</p>
        <p style="font-size:10px; color:#9CA3AF;">branches</p>
      </div>
    </div>

    <!-- PRIMARY CTAs -->
    <div style="display:flex; flex-direction:column; gap:10px; max-width:440px; margin:0 auto;">
      <a href={waLink("Hi Sairam Honda, I saw your ad and want today's best price on Honda bikes in Nizamabad. [W-LP]")}
        target="_blank" rel="noopener noreferrer"
        class="tap"
        style="gap:10px; background:#25D366; color:white; padding:16px 20px; border-radius:14px; font-weight:900; font-size:17px; min-height:56px;">
        <span class="deco" aria-hidden="true">💬</span> WhatsApp for Today's Price
      </a>
      <a href={`tel:${PHONE}`}
        class="tap"
        style="gap:10px; background:#DC2626; color:white; padding:14px 20px; border-radius:14px; font-weight:800; font-size:16px; min-height:52px;">
        <span class="deco" aria-hidden="true">📞</span> Call {PHONE_DISP}
      </a>
    </div>

    <p style="font-size:11px; color:#9CA3AF; margin-top:10px;">Mon–Sat · 9 AM – 7 PM · All 7 branches</p>
  </section>

  <!-- BIKES -->
