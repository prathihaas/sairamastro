  <section style="padding:0 16px 24px; max-width:600px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
      <span style="font-size:28px; font-weight:900; color:#111;">4.0</span>
      <div>
