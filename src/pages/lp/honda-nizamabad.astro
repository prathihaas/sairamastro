            style="background:white; border:1.5px solid #E5E7EB; border-radius:12px; padding:12px 14px; display:flex; flex-direction:column; align-items:flex-start; justify-content:center; min-height:64px;">
            <p style="font-weight:800; font-size:13px; color:#111; margin-bottom:4px;">{b.name}</p>
            <p style="font-size:12px; color:#DC2626; font-weight:700;"><span class="deco" aria-hidden="true">📞</span> {b.phone}</p>
          </a>
        ))}
      </div>
      <p style="text-align:center; font-size:11px; color:#9CA3AF; margin-top:12px;">
        Tap any branch to call directly
      </p>
    </div>
  </section>

  <!-- TRUST SIGNALS -->
  <section style="padding:24px 16px; max-width:600px; margin:0 auto;">
    <h2 style="font-size:17px; font-weight:900; text-align:center; margin-bottom:14px; color:#111;">Why Sairam Honda</h2>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
      {[
        { title: "Authorized Honda", sub: "Official dealer since 2008" },
        { title: "17+ years local", sub: "1,159+ Google reviews" },
        { title: "Finance in-house", sub: "4 bank partners on-site" },
        { title: "Genuine Honda parts", sub: "100% OEM inventory" },
        { title: "Exchange accepted", sub: "Any old bike, free valuation" },
