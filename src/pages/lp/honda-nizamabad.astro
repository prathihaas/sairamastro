          class="card tap"
          style="justify-content:space-between; background:#fff; border:1.5px solid #E5E7EB; border-radius:14px; padding:14px 16px; position:relative; overflow:hidden; min-height:76px;">
          {bike.tag && (
            <div class="deco" aria-hidden="true" style="position:absolute; top:0; right:0; background:#DC2626; color:white; font-size:9px; font-weight:700; padding:3px 8px; border-radius:0 14px 0 8px; letter-spacing:0.5px;">
              {bike.tag}
            </div>
          )}
