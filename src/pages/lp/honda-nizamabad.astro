        <p style="font-size:11px; color:#9CA3AF;">1,159+ Google reviews</p>
      </div>
    </div>
    <div style="display:flex; flex-direction:column; gap:8px;">
      {[
        { name: "B Naveen", text: "Good experience. Staff is very helpful and the service was smooth." },
        { name: "Ravindra Reddy", text: "Received the exact Activa 125 price I was quoted. Delivery in 2 days." },
        { name: "Pradeep", text: "Hassle-free process. The team was cooperative and the showroom is well-kept." },
