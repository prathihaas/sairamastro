        <div style="background:#F9FAFB; border:1.5px solid #E5E7EB; border-radius:12px; padding:14px 16px;">
          <p style="color:#FBBF24; font-size:14px; margin-bottom:6px;" aria-hidden="true">★★★★★</p>
          <p style="font-size:13px; color:#374151; line-height:1.5; margin-bottom:8px;">"{r.text}"</p>
