      </div>
      <div class="deco" aria-hidden="true" style="background:#DC2626; color:white; padding:10px 16px; border-radius:10px; font-weight:800; font-size:13px; white-space:nowrap;">
        Book →
      </div>
    </a>
  </section>

  <!-- BRANCHES -->
  <section style="padding:24px 16px; background:#F9FAFB; border-top:1px solid #E5E7EB; border-bottom:1px solid #E5E7EB;">
    <div style="max-width:600px; margin:0 auto;">
