  { name: "Honda Dio 125",    price: "₹88,000 onwards",  emi: "₹2,400/mo", tag: "" },
  { name: "Honda SP 125",     price: "₹96,000 onwards",  emi: "₹2,600/mo", tag: "" },
  { name: "Honda Hornet 2.0", price: "₹1,35,000 onwards", emi: "₹3,700/mo", tag: "" },
];

const branches = [
  { name: "Nizamabad (Main)", phone: "8886640573" },
  { name: "Armoor",           phone: "9052416222" },
  { name: "Bodhan",           phone: "8886022883" },
  { name: "Dichpally",        phone: "8501981831" },
  { name: "Dharpally",        phone: "9052116565" },
  { name: "Nandipet",         phone: "9052112384" },
  { name: "Bichkunda",        phone: "9052119555" },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is the on-road price of Honda Activa 125 in Nizamabad?", "acceptedAnswer": { "@type": "Answer", "text": "Honda Activa 125 on-road price in Nizamabad starts from around ₹90,000. Contact Sairam Honda on 8886640573 for today's exact price including taxes, insurance and registration." }},
    { "@type": "Question", "name": "Where is the nearest Honda showroom in Nizamabad?", "acceptedAnswer": { "@type": "Answer", "text": "Sairam Honda has 7 showrooms — Nizamabad (main), Armoor, Bodhan, Dichpally, Dharpally, Nandipet, Bichkunda. Call 8886640573 for the nearest one." }},
    { "@type": "Question", "name": "Does Sairam Honda offer EMI for Honda bikes?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. EMI starts from around ₹2,500/month on select models through multiple bank partners." }},
    { "@type": "Question", "name": "What is the Honda Activa 125 on-road price in Armoor?", "acceptedAnswer": { "@type": "Answer", "text": "Honda Activa 125 on-road price in Armoor starts from around ₹90,000. Visit Sairam Honda Armoor or call 9052416222 for today's offer." }}
  ]
};

const localSchema = {
  "@context": "https://schema.org",
  "@type": "AutoDealer",
  "name": "Sairam Honda Nizamabad",
  "telephone": "+91-8886640573",
  "url": "https://www.sairamhonda.com/lp/honda-nizamabad",
  "address": { "@type": "PostalAddress", "streetAddress": "Hyderabad Road, Near Collectorate", "addressLocality": "Nizamabad", "addressRegion": "Telangana", "postalCode": "503001", "addressCountry": "IN" },
  "geo": { "@type": "GeoCoordinates", "latitude": 18.6725, "longitude": 78.0941 },
  "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.0", "reviewCount": "1159", "bestRating": "5" },
  "openingHoursSpecification": [{ "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "09:00", "closes": "19:00" }]
};
