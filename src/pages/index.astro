---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BilingualText from '../components/BilingualText.astro';
import ProductCard from '../components/ProductCard.astro';

// Fetch Content
const homePage = await getEntry('pages', 'home');
const products = await getCollection('products');
const branches = await getCollection('branches');

if (!homePage) {
  throw new Error("Could not find 'home' entry in 'pages' collection.");
}

const { title_en, title_te, description_en, description_te, seo_title, seo_description, hero_image } = homePage.data;

const shRatingSchema = {
  "@context": "https://schema.org",
  "@type": "AutoDealer",
  "name": "Sairam Honda",
  "url": "https://www.sairamhonda.com",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.0",
    "reviewCount": "1159",
    "bestRating": "5",
    "worstRating": "1"
  }
};
---

<Layout title={seo_title} description={seo_description}>
  
  <!-- HERO SECTION -->
  <div class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-4xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-700 mb-6">
          <span class="text-xs font-bold uppercase tracking-wider">No.1 Dealer in Nizamabad</span>
        </div>
        
        <BilingualText 
          size="h1"
          class="mb-8"
          en={title_en}
          te={title_te}
        />

        <div class="mt-4 max-w-2xl mx-auto mb-10">
            <p class="text-lg text-gray-600">{description_en}</p>
            <p class="text-base text-gray-500 font-noto mt-1">{description_te}</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/products" class="flex flex-col items-center bg-gray-900 text-white px-8 py-4 rounded-xl hover:bg-gray-800 transition shadow-lg hover:shadow-xl">
            <span class="font-bold">View Latest Models</span>
            <span class="text-xs text-gray-400 font-noto mt-1">కొత్త మోడళ్లను చూడండి</span>
          </a>
        </div>
      </div>

      <div class="mt-16 relative">
        <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent z-10 h-full w-full"></div>
        <img 
          src={hero_image} 
          alt="Honda Showroom" 
          class="rounded-2xl shadow-2xl w-full object-cover h-64 md:h-[500px] grayscale-[20%]"
        />
      </div>
    </div>
  </div>

  <!-- FEATURES SECTION -->
  <div class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="flex flex-col items-center text-center p-6 rounded-2xl bg-gray-50 border border-gray-100">
            <div class="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mb-4 font-bold text-xl">1</div>
            <BilingualText size="h3" en="Authorized Dealer" te="అధీకృత డీలర్" class="mb-2" />
            <p class="text-sm text-gray-600">Genuine parts & warranty service.</p>
          </div>
          <div class="flex flex-col items-center text-center p-6 rounded-2xl bg-gray-50 border border-gray-100">
            <div class="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mb-4 font-bold text-xl">2</div>
            <BilingualText size="h3" en="Expert Service" te="నిపుణులైన సర్వీసింగ్" class="mb-2" />
            <p class="text-sm text-gray-600">Trained technicians for your vehicle.</p>
          </div>
          <div class="flex flex-col items-center text-center p-6 rounded-2xl bg-gray-50 border border-gray-100">
             <div class="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mb-4 font-bold text-xl">3</div>
            <BilingualText size="h3" en="Quick Finance" te="త్వరిత ఫైనాన్స్" class="mb-2" />
            <p class="text-sm text-gray-600">Easy EMI options available.</p>
          </div>
      </div>
    </div>
  </div>

  <!-- PRODUCT GRID -->
  <div class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-12">
        <BilingualText 
          size="h2" 
          en="Our Collection" 
          te="మా వాహన శ్రేణి" 
        />
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {products.map((product) => (
          <ProductCard 
            title_en={product.data.name_en}
            title_te={product.data.name_te}
            price={product.data.price}
            mileage={product.data.mileage || 'N/A'}
            image={product.data.featured_image || ''}
            slug={product.slug}
            category={product.data.category}
          />
        ))}
      </div>
    </div>
  </div>

  <!-- SERVICE SECTION -->
  <div class="py-20 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-red-600 opacity-10 rounded-full blur-3xl transform translate-x-1/2 -translate-y-1/2"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-red-500 font-bold tracking-wider uppercase text-sm">Service & Support</span>
          <h2 class="text-4xl font-bold mt-2 mb-2">Expert Care for Your Honda</h2>
          <h3 class="text-xl text-gray-400 font-noto font-medium mb-6">మీ హోండా కోసం నిపుణుల సంరక్షణ</h3>
          
          <ul class="space-y-4 mb-8">
              <li class="flex items-center gap-3"><span class="text-red-500">✓</span> Genuine Spare Parts (అసలైన విడిభాగాలు)</li>
              <li class="flex items-center gap-3"><span class="text-red-500">✓</span> Trained Technicians (శిక్షణ పొందిన మెకానిక్స్)</li>
              <li class="flex items-center gap-3"><span class="text-red-500">✓</span> Online Booking (ఆన్‌లైన్ బుకింగ్)</li>
          </ul>
          
          <a href="https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20book%20a%20service%20for%20my%20Honda.%20%5BW-SH%5D" class="inline-flex bg-red-600 text-white px-6 py-3 rounded-lg font-bold hover:bg-red-700 transition">
            Book Service Now
          </a>
        </div>
        <div class="relative">
          <img 
            src="https://yashhonda.com/wp-content/uploads/2020/05/workshop-min-1024x382-1.png" 
            alt="Service Center" 
            class="rounded-2xl shadow-2xl border border-gray-700 opacity-90"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- BRANCHES SECTION -->
  <div class="py-16 bg-white" id="branches">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <BilingualText size="h2" en="Visit our Showrooms" te="మా షోరూమ్‌లను సందర్శించండి" class="mb-12 text-center" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {branches.map((branch) => (
          <div class="bg-white rounded-2xl border border-gray-200 p-6 hover:border-red-200 transition-colors shadow-sm">
            <div class="flex items-start justify-between mb-4">
              <BilingualText size="large" en={branch.data.name_en} te={branch.data.name_te} />
            </div>
            
            <div class="space-y-4 mb-6">
              <p class="text-gray-600 leading-relaxed">
                {branch.data.address_en}
                <span class="block text-gray-500 text-sm font-noto mt-1">{branch.data.address_te}</span>
              </p>
              <div class="flex items-center gap-2 text-gray-900 font-bold">
                {branch.data.phone}
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <a href={branch.data.map_link} target="_blank" class="flex items-center justify-center gap-2 border border-gray-200 rounded-lg py-2 hover:bg-gray-50 font-medium text-sm">
                Get Directions
              </a>
              <a href="https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20enquire%20about%20Honda%202-wheelers.%20%5BW-SH%5D" class="flex items-center justify-center gap-2 bg-green-50 text-green-700 border border-green-200 rounded-lg py-2 hover:bg-green-100 font-medium text-sm">
                 WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>


  <!-- Customer Reviews Section -->
  <script type="application/ld+json" set:html={JSON.stringify(shRatingSchema)} />
  <section class="py-16 bg-gray-50 border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-black text-gray-900 mb-1">What Our Customers Say</h2>
        <p class="font-noto text-lg text-gray-500 mb-4">మా కస్టమర్ల అభిప్రాయాలు</p>
        <div class="flex items-center justify-center gap-3 mb-1">
          <span class="text-yellow-400 text-2xl tracking-tight">★★★★</span><span class="text-yellow-300 text-2xl">★</span>
          <span class="text-4xl font-black text-gray-900">4.0</span>
          <span class="text-gray-500 text-base">/ 5 &nbsp;·&nbsp; <strong class="text-gray-700">1,159+ reviews</strong></span>
        </div>
        <p class="text-gray-500 text-sm">Trusted by Honda riders across Nizamabad, Armoor, Bodhan &amp; 5 more locations</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-5 mb-8">
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
          <div class="text-yellow-400 text-lg mb-2">★★★★★</div>
          <p class="text-gray-700 text-sm leading-relaxed mb-4">"Good experience from Sairam Honda. Staff is very helpful and the service was smooth."</p>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-red-600 text-white text-xs flex items-center justify-center font-bold">B</div>
            <span class="text-sm font-semibold text-gray-700">B Naveen</span>
          </div>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
          <div class="text-yellow-400 text-lg mb-2">★★★★★</div>
          <p class="text-gray-700 text-sm leading-relaxed mb-4">"Excellent and good service at Sairam Honda Nizamabad. Highly recommended for Honda bikes and scooters."</p>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-red-600 text-white text-xs flex items-center justify-center font-bold">R</div>
            <span class="text-sm font-semibold text-gray-700">Ravindra Reddy</span>
          </div>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
          <div class="text-yellow-400 text-lg mb-2">★★★★★</div>
          <p class="text-gray-700 text-sm leading-relaxed mb-4">"Nice and good service. The process was hassle-free and the team was very cooperative."</p>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-red-600 text-white text-xs flex items-center justify-center font-bold">P</div>
            <span class="text-sm font-semibold text-gray-700">Pradeep</span>
          </div>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
          <div class="text-yellow-400 text-lg mb-2">★★★★★</div>
          <p class="text-gray-700 text-sm leading-relaxed mb-4">"Good service. Smooth buying process and very friendly staff at the showroom."</p>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-red-600 text-white text-xs flex items-center justify-center font-bold">V</div>
            <span class="text-sm font-semibold text-gray-700">Vikhil</span>
          </div>
        </div>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://www.google.com/maps/search/Sairam+Honda+Nizamabad" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-white border-2 border-gray-200 text-gray-800 px-8 py-4 rounded-xl font-bold hover:border-red-300 hover:bg-red-50 transition shadow-sm">
          <svg class="w-6 h-6" viewBox="0 0 48 48"><path d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.5 6.9 29.6 5 24 5 13 5 4 14 4 25s9 20 20 20c11 0 20-9 20-20 0-1.3-.1-2.6-.4-3.9z" fill="#FFC107"/><path d="M6.3 15.4l6.6 4.8C14.6 16.2 19 13 24 13c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.5 7 29.6 5 24 5 16.3 5 9.7 9.2 6.3 15.4z" fill="#FF3D00"/><path d="M24 45c5.5 0 10.5-2.1 14.3-5.5l-6.6-5.6C29.7 35.8 27 37 24 37c-5.3 0-9.7-3.3-11.3-8H6.5C9.9 38.9 16.4 45 24 45z" fill="#4CAF50"/><path d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4 5.5l6.6 5.6C37.8 37.9 44 33 44 25c0-1.3-.1-2.6-.4-3.9z" fill="#1976D2"/></svg>
          Read All Google Reviews
        </a>
        <a href="https://www.google.com/maps/search/Sairam+Honda+Nizamabad" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-red-600 text-white px-8 py-4 rounded-xl font-bold hover:bg-red-700 transition shadow-lg">
          ✍ Write a Review
        </a>
      </div>
    </div>
  </section>

</Layout>
