---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BilingualText from '../components/BilingualText.astro';
import ProductCard from '../components/ProductCard.astro';

const homePage = await getEntry('pages', 'home');
const products = await getCollection('products');
const branches = await getCollection('branches');

if (!homePage) {
  throw new Error("Could not find 'home' entry in 'pages' collection.");
}

const { title_en, title_te, description_en, description_te, seo_title, seo_description, hero_image } = homePage.data;

// Comprehensive LocalBusiness schema with all 7 branches
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "AutoDealer",
  "name": "Sairam Honda",
  "url": "https://www.sairamhonda.com",
  "logo": "https://www.sairamhonda.com/logo.png",
  "telephone": "+91-8886640573",
  "description": "Authorized Honda two-wheeler dealer with 7 branches across Nizamabad district, Telangana.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Hyderabad Road, Near Collectorate",
    "addressLocality": "Nizamabad",
    "addressRegion": "Telangana",
    "postalCode": "503001",
    "addressCountry": "IN"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 18.6725, "longitude": 78.0941 },
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
    "opens": "09:00",
    "closes": "19:00"
  }],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.0",
    "reviewCount": "1159",
    "bestRating": "5"
  },
  "brand": { "@type": "Brand", "name": "Honda" },
  "areaServed": ["Nizamabad", "Armoor", "Bodhan", "Dichpally", "Dharpally", "Nandipet", "Bichkunda"],
  "department": [
    {
      "@type": "AutoDealer",
      "name": "Sairam Honda — Armoor",
      "telephone": "+91-9052416222",
      "address": { "@type": "PostalAddress", "streetAddress": "Mahalakshmi Complex, Perkit Road", "addressLocality": "Armoor", "addressRegion": "Telangana", "postalCode": "503224", "addressCountry": "IN" },
      "geo": { "@type": "GeoCoordinates", "latitude": 18.7945, "longitude": 78.2920 },
      "url": "https://www.sairamhonda.com/branches/armoor"
    },
    {
      "@type": "AutoDealer",
      "name": "Sairam Honda — Bodhan",
      "telephone": "+91-8886022883",
      "address": { "@type": "PostalAddress", "streetAddress": "Main Road", "addressLocality": "Bodhan", "addressRegion": "Telangana", "postalCode": "503185", "addressCountry": "IN" },
      "geo": { "@type": "GeoCoordinates", "latitude": 18.6633, "longitude": 77.9025 },
      "url": "https://www.sairamhonda.com/branches/bodhan"
    },
    {
      "@type": "AutoDealer",
      "name": "Sairam Honda — Dichpally",
      "telephone": "+91-8501981831",
      "address": { "@type": "PostalAddress", "streetAddress": "Main Road", "addressLocality": "Dichpally", "addressRegion": "Telangana", "postalCode": "503230", "addressCountry": "IN" },
      "geo": { "@type": "GeoCoordinates", "latitude": 18.5969, "longitude": 77.9695 },
      "url": "https://www.sairamhonda.com/branches/dichpally"
    },
    {
      "@type": "AutoDealer",
      "name": "Sairam Honda — Dharpally",
      "telephone": "+91-9052116565",
      "address": { "@type": "PostalAddress", "streetAddress": "Main Road", "addressLocality": "Dharpally", "addressRegion": "Telangana", "postalCode": "503175", "addressCountry": "IN" },
      "geo": { "@type": "GeoCoordinates", "latitude": 18.6900, "longitude": 78.0800 },
      "url": "https://www.sairamhonda.com/branches/dharpally"
    },
    {
      "@type": "AutoDealer",
      "name": "Sairam Honda — Nandipet",
      "telephone": "+91-9052112384",
      "address": { "@type": "PostalAddress", "streetAddress": "Main Road", "addressLocality": "Nandipet", "addressRegion": "Telangana", "postalCode": "503111", "addressCountry": "IN" },
      "geo": { "@type": "GeoCoordinates", "latitude": 18.8478, "longitude": 78.2839 },
      "url": "https://www.sairamhonda.com/branches/nandipet"
    },
    {
      "@type": "AutoDealer",
      "name": "Sairam Honda — Bichkunda",
      "telephone": "+91-9052119555",
      "address": { "@type": "PostalAddress", "streetAddress": "Main Road", "addressLocality": "Bichkunda", "addressRegion": "Telangana", "postalCode": "503302", "addressCountry": "IN" },
      "geo": { "@type": "GeoCoordinates", "latitude": 18.4847, "longitude": 78.2158 },
      "url": "https://www.sairamhonda.com/branches/bichkunda"
    }
  ]
};

// FAQ Schema for rich results
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where is Sairam Honda showroom in Nizamabad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sairam Honda Nizamabad main showroom is located at Hyderabad Road, Near Collectorate, Nizamabad — 503001. We also have 6 more branches in Armoor, Bodhan, Dichpally, Dharpally, Nandipet and Bichkunda."
      }
    },
    {
      "@type": "Question",
      "name": "What is the price of Honda Activa 125 in Nizamabad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Honda Activa 125 on-road price in Nizamabad starts from ₹90,000 onwards. Contact Sairam Honda on 8886640573 for today's best offer and EMI options."
      }
    },
    {
      "@type": "Question",
      "name": "Does Sairam Honda offer EMI for Honda bikes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Sairam Honda offers easy EMI options starting from ₹2,500/month for Honda bikes and scooters through multiple finance partners. Zero down payment schemes also available on select models."
      }
    },
    {
      "@type": "Question",
      "name": "What are Sairam Honda showroom timings?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sairam Honda showrooms are open Monday to Saturday, 9 AM to 7 PM. All 7 branches across Nizamabad district follow the same timings."
      }
    },
    {
      "@type": "Question",
      "name": "Which Honda bikes are available at Sairam Honda Nizamabad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sairam Honda Nizamabad has the full Honda range — Honda Activa 125, Activa 110, Shine 125, Shine 100, SP 125, SP 160, Unicorn, Dio 110, Dio 125, Livo, Hornet 2.0, CB Hornet 125, and CB200X."
      }
    },
    {
      "@type": "Question",
      "name": "How to contact Sairam Honda Nizamabad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Call Sairam Honda on +91 8886640573 or WhatsApp us at wa.me/919666679377. You can also visit any of our 7 branches in Nizamabad, Armoor, Bodhan, Dichpally, Dharpally, Nandipet and Bichkunda."
      }
    }
  ]
};
---

<Layout title={seo_title} description={seo_description}>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION — Conversion focused with Call + WhatsApp CTAs -->
  <div class="relative pt-28 pb-12 md:pt-40 md:pb-20 overflow-hidden bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-4xl mx-auto">

        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-700 mb-4">
          <span class="text-xs font-bold uppercase tracking-wider">✓ Authorized Honda Dealer — Nizamabad</span>
        </div>

        <!-- H1 explicitly targets "Honda Showroom Nizamabad" for SEO -->
        <h1 class="text-4xl md:text-5xl font-black tracking-tight text-gray-900 mb-3 leading-tight">
          Honda Showroom Nizamabad<br/>
          <span class="text-red-600">— Best Price, 7 Branches</span>
        </h1>
        <p class="text-lg text-gray-500 font-noto mb-2">{title_te}</p>

        <p class="text-base md:text-lg text-gray-600 max-w-2xl mx-auto mb-3">
          {description_en}
        </p>
        <p class="text-sm text-gray-500 font-noto mb-8">{description_te}</p>

        <!-- PRIMARY CTAs: Call + WhatsApp prominently above fold -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center mb-4">
          <a href="tel:+918886640573"
            class="flex items-center justify-center gap-3 bg-red-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-red-700 transition shadow-lg shadow-red-200 active:scale-95">
            📞 Call Now — 8886640573
          </a>
          <a href="https://wa.me/919666679377?text=Hi%20Sairam%20Honda%2C%20I%20want%20to%20know%20today%27s%20best%20offer%20on%20Honda%20bikes.%20%5BW-HP%5D"
            target="_blank" rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 bg-green-600 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-green-700 transition shadow-lg shadow-green-200 active:scale-95">
            💬 WhatsApp for Best Price
          </a>
        </div>

        <!-- Secondary CTA -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center mb-2">
          <a href="/products" class="inline-flex items-center gap-2 text-gray-700 border border-gray-200 px-6 py-3 rounded-xl hover:border-red-300 hover:bg-red-50 font-semibold transition text-sm">
            🏍️ View All Honda Models
          </a>
          <a href="#branches" class="inline-flex items-center gap-2 text-gray-700 border border-gray-200 px-6 py-3 rounded-xl hover:border-red-300 hover:bg-red-50 font-semibold transition text-sm">
            📍 Find Nearest Showroom
          </a>
        </div>

        <!-- Social Proof Strip -->
        <div class="flex items-center justify-center gap-6 mt-6 text-sm text-gray-500 flex-wrap">
          <span>⭐ 4.0/5 Rating</span>
          <span>•</span>
          <span>👥 1,159+ Reviews</span>
          <span>•</span>
          <span>🏪 7 Branches</span>
          <span>•</span>
          <span>✅ Honda Authorized</span>
        </div>
      </div>

      <div class="mt-12 relative">
        <div class="absolute inset-0 bg-gradient-to-t from-white via-transparent to-transparent z-10 h-full w-full"></div>
        <img
          src={hero_image}
          alt="Honda Showroom Nizamabad — Sairam Honda"
          class="rounded-2xl shadow-2xl w-full object-cover h-64 md:h-[480px] grayscale-[10%]"
        />
      </div>
    </div>
  </div>

  <!-- EMI HIGHLIGHT STRIP -->
  <div class="bg-red-600 text-white py-4">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-center gap-4 text-center sm:text-left">
      <p class="font-bold text-lg">🎯 Honda Activa Starting ₹2,500/month EMI</p>
      <span class="hidden sm:block text-red-200">|</span>
      <p class="text-sm text-red-100">Zero Down Payment on select models · Instant Approval</p>
      <a href="https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20know%20about%20Honda%20EMI%20options.%20%5BW-EMI%5D"
        target="_blank" rel="noopener noreferrer"
        class="bg-white text-red-600 px-5 py-2 rounded-lg font-bold text-sm hover:bg-red-50 transition whitespace-nowrap">
        Check EMI →
      </a>
    </div>
  </div>

  <!-- TRUST FEATURES -->
  <div class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="flex flex-col items-center text-center p-5 rounded-2xl bg-gray-50 border border-gray-100">
          <div class="text-2xl mb-2">🏆</div>
          <p class="font-bold text-gray-900 text-sm">Authorized Dealer</p>
          <p class="text-xs text-gray-500 font-noto mt-1">అధీకృత డీలర్</p>
        </div>
        <div class="flex flex-col items-center text-center p-5 rounded-2xl bg-gray-50 border border-gray-100">
          <div class="text-2xl mb-2">🔧</div>
          <p class="font-bold text-gray-900 text-sm">Expert Service</p>
          <p class="text-xs text-gray-500 font-noto mt-1">నిపుణుల సర్వీస్</p>
        </div>
        <div class="flex flex-col items-center text-center p-5 rounded-2xl bg-gray-50 border border-gray-100">
          <div class="text-2xl mb-2">💰</div>
          <p class="font-bold text-gray-900 text-sm">Easy EMI</p>
          <p class="text-xs text-gray-500 font-noto mt-1">సులభ EMI</p>
        </div>
        <div class="flex flex-col items-center text-center p-5 rounded-2xl bg-gray-50 border border-gray-100">
          <div class="text-2xl mb-2">📍</div>
          <p class="font-bold text-gray-900 text-sm">7 Locations</p>
          <p class="text-xs text-gray-500 font-noto mt-1">7 శాఖలు</p>
        </div>
      </div>
    </div>
  </div>

  <!-- PRODUCT GRID -->
  <div class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-10 gap-3">
        <div>
          <h2 class="text-3xl font-black text-gray-900">Honda Bikes & Scooters in Nizamabad</h2>
          <p class="font-noto text-gray-500 mt-1">నిజామాబాద్‌లో హోండా బైక్స్ మరియు స్కూటర్లు</p>
        </div>
        <a href="/products" class="text-red-600 font-bold hover:underline text-sm whitespace-nowrap">View All Models →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {products.map((product) => (
          <ProductCard
            title_en={product.data.name_en}
            title_te={product.data.name_te}
            price={product.data.price}
            mileage={product.data.mileage || 'N/A'}
            image={product.data.featured_image || ''}
            slug={product.slug}
            category={product.data.category}
          />
        ))}
      </div>

      <!-- Internal links to top products -->
      <div class="mt-10 p-6 bg-white rounded-2xl border border-gray-100">
        <p class="font-bold text-gray-700 mb-4 text-sm">Popular Models at <a href="/" class="text-red-600 hover:underline">Honda Showroom Nizamabad</a>:</p>
        <div class="flex flex-wrap gap-2">
          {[
            {slug: "activa-125", name: "Honda Activa 125 Nizamabad"},
            {slug: "activa-110", name: "Honda Activa 110"},
            {slug: "shine-125", name: "Honda Shine 125"},
            {slug: "sp-160", name: "Honda SP 160"},
            {slug: "unicorn", name: "Honda Unicorn"},
            {slug: "dio-125", name: "Honda Dio 125"},
            {slug: "cb200x", name: "Honda CB200X"},
            {slug: "hornet-2-0", name: "Honda Hornet 2.0"},
          ].map(b => (
            <a href={`/products/${b.slug}`} class="text-xs text-red-600 bg-red-50 px-3 py-1 rounded-full hover:bg-red-100 font-semibold transition">
              {b.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- SERVICE SECTION -->
  <div class="py-20 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-red-600 opacity-10 rounded-full blur-3xl transform translate-x-1/2 -translate-y-1/2"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-red-500 font-bold tracking-wider uppercase text-sm">Service & Support</span>
          <h2 class="text-4xl font-bold mt-2 mb-2">Expert Honda Service in Nizamabad</h2>
          <h3 class="text-xl text-gray-400 font-noto font-medium mb-6">నిజామాబాద్‌లో హోండా సర్వీసింగ్</h3>
          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3"><span class="text-red-500">✓</span> Genuine Honda Spare Parts</li>
            <li class="flex items-center gap-3"><span class="text-red-500">✓</span> Honda-Trained Technicians</li>
            <li class="flex items-center gap-3"><span class="text-red-500">✓</span> Service at All 7 Locations</li>
            <li class="flex items-center gap-3"><span class="text-red-500">✓</span> Free Pickup & Drop (select models)</li>
          </ul>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20book%20a%20service%20for%20my%20Honda.%20%5BW-SVC%5D"
              target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-green-600 text-white px-6 py-3 rounded-lg font-bold hover:bg-green-700 transition">
              💬 Book Service via WhatsApp
            </a>
            <a href="tel:+918886640573"
              class="inline-flex items-center justify-center gap-2 border border-gray-600 text-white px-6 py-3 rounded-lg font-bold hover:bg-gray-800 transition">
              📞 Call for Service
            </a>
          </div>
        </div>
        <div class="relative">
          <img
            src="https://yashhonda.com/wp-content/uploads/2020/05/workshop-min-1024x382-1.png"
            alt="Honda Service Center Nizamabad — Sairam Honda"
            class="rounded-2xl shadow-2xl border border-gray-700 opacity-90"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- BRANCHES SECTION — Each card is now a link (fixes 75 dead clicks) -->
  <div class="py-16 bg-white" id="branches">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-black text-gray-900">Honda Showrooms Near You</h2>
        <p class="font-noto text-gray-500 mt-2 mb-1">నిజామాబాద్ జిల్లాలో మా షోరూమ్‌లు</p>
        <p class="text-sm text-gray-400">7 branches across Nizamabad, Armoor, Bodhan, Dichpally, Dharpally, Nandipet & Bichkunda</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {branches.map((branch) => (
          <a href={`/branches/${branch.slug}`}
            class="group bg-white rounded-2xl border border-gray-200 p-6 hover:border-red-300 hover:shadow-lg transition-all duration-200 block">
            <div class="flex items-start justify-between mb-3">
              <div>
                <h3 class="text-xl font-bold text-gray-900 group-hover:text-red-600 transition">{branch.data.name_en}</h3>
                <p class="text-sm text-gray-500 font-noto">{branch.data.name_te}</p>
              </div>
              <span class="text-red-500 text-lg group-hover:translate-x-1 transition-transform">→</span>
            </div>

            <p class="text-gray-600 text-sm leading-relaxed mb-1">{branch.data.address_en}</p>
            <p class="text-xs text-gray-400 font-noto mb-4">{branch.data.address_te}</p>

            <div class="flex items-center gap-2 mb-5">
              <span class="text-xs text-gray-500">📞</span>
              <span class="font-bold text-gray-900 text-sm">{branch.data.phone}</span>
              <span class="text-xs text-gray-400 ml-auto">Mon–Sat, 9AM–7PM</span>
            </div>

            <div class="grid grid-cols-3 gap-2" onclick="event.preventDefault()">
              <a href={`tel:${branch.data.phone.replace(/\s/g, '')}`}
                class="flex items-center justify-center gap-1 bg-red-600 text-white rounded-lg py-2 font-bold text-xs hover:bg-red-700 transition"
                onclick="event.stopPropagation()">
                📞 Call
              </a>
              <a href={branch.data.map_link} target="_blank" rel="noopener noreferrer"
                class="flex items-center justify-center gap-1 border border-gray-200 rounded-lg py-2 font-semibold text-xs hover:bg-gray-50 transition text-gray-700"
                onclick="event.stopPropagation()">
                🗺️ Directions
              </a>
              <a href={`https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20visit%20Sairam%20Honda%20${encodeURIComponent(branch.data.name_en)}.%20%5BW-BR%5D`}
                target="_blank" rel="noopener noreferrer"
                class="flex items-center justify-center gap-1 bg-green-50 text-green-700 border border-green-200 rounded-lg py-2 font-bold text-xs hover:bg-green-100 transition"
                onclick="event.stopPropagation()">
                💬 WhatsApp
              </a>
            </div>
          </a>
        ))}
      </div>

      <!-- Internal links to branch pages -->
      <div class="mt-8 text-center">
        <p class="text-sm text-gray-500 mb-3">Find your nearest Honda showroom:</p>
        <div class="flex flex-wrap justify-center gap-2">
          {branches.map(b => (
            <a href={`/branches/${b.slug}`}
              class="text-xs text-red-600 bg-red-50 px-3 py-1 rounded-full hover:bg-red-100 font-semibold transition">
              Honda Showroom {b.data.name_en.replace(' Branch','').replace(' Showroom','')}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- REVIEWS SECTION -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AutoDealer",
    "name": "Sairam Honda",
    "url": "https://www.sairamhonda.com",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.0",
      "reviewCount": "1159",
      "bestRating": "5",
      "worstRating": "1"
    }
  })} />
  <section class="py-16 bg-gray-50 border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-black text-gray-900 mb-1">What Our Customers Say</h2>
        <p class="font-noto text-lg text-gray-500 mb-4">మా కస్టమర్ల అభిప్రాయాలు</p>
        <div class="flex items-center justify-center gap-3 mb-1">
          <span class="text-yellow-400 text-2xl">★★★★</span><span class="text-yellow-300 text-2xl">★</span>
          <span class="text-4xl font-black text-gray-900">4.0</span>
