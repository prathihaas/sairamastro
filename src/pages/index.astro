---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BilingualText from '../components/BilingualText.astro';
import ProductCard from '../components/ProductCard.astro';

const homePage = await getEntry('pages', 'home');
const products = await getCollection('products');
const branches = await getCollection('branches');
const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allBlogPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

if (!homePage) {
  throw new Error("Could not find 'home' entry in 'pages' collection.");
}

const { title_en, title_te, description_en, description_te, seo_title, seo_description, hero_image } = homePage.data;

// Organization schema is emitted once by SEOHead.astro — no duplicate needed here

// FAQ Schema for rich results
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where is Sairam Honda showroom in Nizamabad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sairam Honda Nizamabad main showroom is located at Hyderabad Road, Near Collectorate, Nizamabad — 503001. We also have 6 more branches in Armoor, Bodhan, Dichpally, Dharpally, Nandipet and Bichkunda."
      }
    },
    {
      "@type": "Question",
      "name": "What is the price of Honda Activa 125 in Nizamabad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Honda Activa 125 on-road price in Nizamabad starts from ₹1,09,956 onwards (ex-showroom + RTO + insurance). Contact Sairam Honda on 8886640573 for today's best offer and EMI options."
      }
    },
    {
      "@type": "Question",
      "name": "Does Sairam Honda offer EMI for Honda bikes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Sairam Honda offers easy EMI options starting from ₹2,500/month for Honda bikes and scooters through multiple finance partners. Zero down payment schemes also available on select models."
      }
    },
    {
      "@type": "Question",
      "name": "What are Sairam Honda showroom timings?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sairam Honda showrooms are open Monday to Saturday, 9 AM to 7 PM. All 7 branches across Nizamabad district follow the same timings."
      }
    },
    {
      "@type": "Question",
      "name": "Which Honda bikes are available at Sairam Honda Nizamabad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sairam Honda Nizamabad has the full Honda range — Honda Activa 125, Activa 110, Shine 125, Shine 100, SP 125, SP 160, Unicorn, Dio 110, Dio 125, Livo, Hornet 2.0, CB Hornet 125, and CB200X."
      }
    },
    {
      "@type": "Question",
      "name": "How to contact Sairam Honda Nizamabad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Call Sairam Honda on +91 8886640573 or WhatsApp us at wa.me/919666679377. You can also visit any of our 7 branches in Nizamabad, Armoor, Bodhan, Dichpally, Dharpally, Nandipet and Bichkunda."
      }
    }
  ]
};
---

<Layout title={seo_title} description={seo_description} preloadImage={hero_image}>

  <!-- FAQ Schema for rich results — org schema is in SEOHead.astro -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION — Conversion focused with Call + WhatsApp CTAs -->
  <div class="relative pt-28 pb-12 md:pt-40 md:pb-20 overflow-hidden bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-4xl mx-auto">

        <!-- H1 explicitly targets "Honda Showroom Nizamabad" for SEO -->
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-black mb-3 leading-tight">
          Honda Showroom Nizamabad<br/>
          <span class="text-red-600">— Best Price, 7 Branches</span>
        </h1>
        <p class="text-h-sm text-gray-600 font-noto mb-2" style="pointer-events:none; user-select:none;">{title_te}</p>

        <p class="text-base md:text-lg text-gray-600 max-w-2xl mx-auto mb-3" style="pointer-events:none;">
          {description_en}
        </p>
        <p class="text-sm text-gray-600 font-noto mb-8" style="pointer-events:none; user-select:none;">{description_te}</p>

        <!-- PRIMARY CTAs: Call + WhatsApp prominently above fold -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center mb-4">
          <a href="tel:+918886640573"
            class="flex items-center justify-center gap-3 bg-red-600 text-white px-8 py-4 rounded-pill font-semibold text-lg hover:bg-red-700 transition active:scale-95">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            Call Now — 8886640573
          </a>
          <a href="https://wa.me/919666679377?text=Hi%20Sairam%20Honda%2C%20I%20want%20to%20know%20today%27s%20best%20offer%20on%20Honda%20bikes.%20%5BW-HP%5D"
            target="_blank" rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 bg-[#25D366] text-white px-8 py-4 rounded-pill font-semibold text-lg hover:bg-[#20bd5a] transition active:scale-95">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp for Best Price
          </a>
        </div>

        <!-- Secondary CTA -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center mb-2">
          <a href="/products/" class="inline-flex items-center justify-center gap-2 text-black border border-gray-200 bg-white px-6 py-3 rounded-pill hover:border-red-600 font-semibold transition text-sm">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="M15 6h5l-3 5.5M5.5 17.5 9 8h6l3 9.5"/></svg>
            View All Honda Models
          </a>
          <a href="#branches" class="inline-flex items-center justify-center gap-2 text-black border border-gray-200 bg-white px-6 py-3 rounded-pill hover:border-red-600 font-semibold transition text-sm">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Find Nearest Showroom
          </a>
        </div>

        <!-- Social Proof Strip -->
        <div class="flex items-center justify-center gap-x-6 gap-y-2 mt-8 text-sm text-gray-600 flex-wrap">
          <a href="https://www.google.com/search?q=Sairam+Honda+Nizamabad+reviews" target="_blank" rel="noopener noreferrer" class="hover:text-red-600 transition">4.0/5 rating</a>
          <span class="text-gray-300">|</span>
          <a href="https://www.google.com/search?q=Sairam+Honda+Nizamabad+reviews" target="_blank" rel="noopener noreferrer" class="hover:text-red-600 transition">1,159+ Google reviews</a>
          <span class="text-gray-300">|</span>
          <a href="#branches" class="hover:text-red-600 transition">7 branches</a>
          <span class="text-gray-300">|</span>
          <span>Authorized Honda dealer since 2003</span>
        </div>
      </div>

      <div class="mt-12 relative">
        
        <img
          src={hero_image}
          alt="Honda Showroom Nizamabad — Sairam Honda"
          class="rounded-2xl shadow-2xl w-full object-cover h-64 md:h-[480px] grayscale-[10%]"
        />
      </div>
    </div>
  </div>

  <!-- EMI HIGHLIGHT STRIP -->
  <div class="bg-red-600 text-white py-4">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-center gap-4 text-center sm:text-left">
      <p class="font-bold text-lg"> Honda Activa Starting ₹2,500/month EMI</p>
      <span class="hidden sm:block text-red-200">|</span>
      <p class="text-sm text-red-100">Zero Down Payment on select models · Instant Approval</p>
      <a href="https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20know%20about%20Honda%20EMI%20options.%20%5BW-EMI%5D"
        target="_blank" rel="noopener noreferrer"
        class="bg-white text-red-600 px-5 py-2 rounded-pill font-semibold text-sm hover:bg-red-50 transition whitespace-nowrap">
        Check EMI 
      </a>
    </div>
  </div>

  <!-- TRUST FEATURES -->
  <div class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="tel:+918886640573" class="flex flex-col items-center text-center p-5 rounded-2xl bg-gray-50 border border-gray-200 hover:border-red-600 hover:bg-red-50 transition">
          <div class="text-2xl mb-2"></div>
          <p class="font-bold text-gray-900 text-sm">Authorized Dealer</p>
          <p class="text-xs text-gray-500 font-noto mt-1">అధీకృత డీలర్</p>
        </a>
        <a href="/service/" class="flex flex-col items-center text-center p-5 rounded-2xl bg-gray-50 border border-gray-200 hover:border-red-600 hover:bg-red-50 transition">
          <div class="text-2xl mb-2"></div>
          <p class="font-bold text-gray-900 text-sm">Expert Service</p>
          <p class="text-xs text-gray-500 font-noto mt-1">నిపుణుల సర్వీస్</p>
        </a>
        <a href="https://wa.me/919666679377?text=Hi%20Sairam%20Honda%2C%20I%20want%20to%20know%20about%20Honda%20EMI%20options.%20%5BW-EMI%5D" target="_blank" rel="noopener noreferrer" class="flex flex-col items-center text-center p-5 rounded-2xl bg-gray-50 border border-gray-200 hover:border-red-600 hover:bg-red-50 transition">
          <div class="text-2xl mb-2"></div>
          <p class="font-bold text-gray-900 text-sm">Easy EMI</p>
          <p class="text-xs text-gray-500 font-noto mt-1">సులభ EMI</p>
        </a>
        <a href="#branches" class="flex flex-col items-center text-center p-5 rounded-2xl bg-gray-50 border border-gray-200 hover:border-red-600 hover:bg-red-50 transition">
          <div class="text-2xl mb-2"></div>
          <p class="font-bold text-gray-900 text-sm">7 Locations</p>
          <p class="text-xs text-gray-500 font-noto mt-1">7 శాఖలు</p>
        </a>
      </div>
    </div>
  </div>

  <!-- PRODUCT GRID -->
  <div class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-10 gap-3">
        <div>
          <h2 class="text-3xl font-semibold text-gray-900">Honda Bikes & Scooters in Nizamabad</h2>
          <p class="font-noto text-gray-500 mt-1">నిజామాబాద్‌లో హోండా బైక్స్ మరియు స్కూటర్లు</p>
        </div>
        <a href="/products/" class="text-red-600 font-bold hover:underline text-sm whitespace-nowrap">View All Models </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {products.map((product) => (
          <ProductCard
            title_en={product.data.name_en}
            title_te={product.data.name_te}
            price={product.data.price}
            mileage={product.data.mileage || 'N/A'}
            image={product.data.featured_image || ''}
            slug={product.slug}
            category={product.data.category}
          />
        ))}
      </div>

      <!-- Internal links to top products -->
      <div class="mt-10 p-6 bg-white rounded-2xl border border-gray-100">
        <p class="font-bold text-gray-700 mb-4 text-sm">Popular Models at <a href="/" class="text-red-600 hover:underline">Honda Showroom Nizamabad</a>:</p>
        <div class="flex flex-wrap gap-2">
          {[
            {slug: "activa-125", name: "Honda Activa 125 Nizamabad"},
            {slug: "activa-110", name: "Honda Activa 110"},
            {slug: "shine-125", name: "Honda Shine 125"},
            {slug: "sp-160", name: "Honda SP 160"},
            {slug: "unicorn", name: "Honda Unicorn"},
            {slug: "dio-125", name: "Honda Dio 125"},
            {slug: "cb200x", name: "Honda CB200X"},
            {slug: "hornet-2-0", name: "Honda Hornet 2.0"},
          ].map(b => (
            <a href={`/products/${b.slug}/`} class="text-xs text-red-600 bg-red-50 px-3 py-1 rounded-full hover:bg-red-100 font-semibold transition">
              {b.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- SERVICE SECTION -->
  <div class="py-20 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-red-600 opacity-10 rounded-full blur-3xl transform translate-x-1/2 -translate-y-1/2"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl font-bold mt-2 mb-2">Expert Honda Service in Nizamabad</h2>
          <h3 class="text-xl text-gray-600 font-noto font-medium mb-6">నిజామాబాద్‌లో హోండా సర్వీసింగ్</h3>
          <ul class="space-y-4 mb-8">
            <li class="flex items-center gap-3"> Genuine Honda Spare Parts</li>
            <li class="flex items-center gap-3"> Honda-Trained Technicians</li>
            <li class="flex items-center gap-3"> Service at All 7 Locations</li>
            <li class="flex items-center gap-3"> Free Pickup & Drop (select models)</li>
          </ul>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20book%20a%20service%20for%20my%20Honda.%20%5BW-SVC%5D"
              target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white px-6 py-3 rounded-pill font-semibold hover:bg-[#20bd5a] transition">
               Book Service via WhatsApp
            </a>
            <a href="tel:+918886640573"
              class="inline-flex items-center justify-center gap-2 border border-gray-600 text-white px-6 py-3 rounded-pill font-semibold hover:bg-gray-800 transition">
               Call for Service
            </a>
          </div>
        </div>
        <div class="relative">
          <img
            src="/images/service-workshop.jpg"
            alt="Honda Service Center Nizamabad — Sairam Honda"
            class="rounded-2xl shadow-2xl border border-gray-700 opacity-90"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- BRANCHES SECTION — Each card is now a link (fixes 75 dead clicks) -->
  <div class="py-16 bg-white" id="branches">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-semibold text-gray-900">Honda Showrooms Near You</h2>
        <p class="font-noto text-gray-500 mt-2 mb-1">నిజామాబాద్ జిల్లాలో మా షోరూమ్‌లు</p>
        <p class="text-sm text-gray-400">7 branches across Nizamabad, Armoor, Bodhan, Dichpally, Dharpally, Nandipet & Bichkunda</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {branches.map((branch) => (
          <a href={`/branches/${branch.slug}/`}
            class="group bg-white rounded-2xl border border-gray-200 p-6 hover:border-red-300 hover:shadow-lg transition-all duration-200 block">
            <div class="flex items-start justify-between mb-3">
              <div>
                <h3 class="text-xl font-bold text-gray-900 group-hover:text-red-600 transition">{branch.data.name_en}</h3>
                <p class="text-sm text-gray-500 font-noto">{branch.data.name_te}</p>
              </div>
            </div>

            <p class="text-gray-600 text-sm leading-relaxed mb-1">{branch.data.address_en}</p>
            <p class="text-xs text-gray-600 font-noto mb-4">{branch.data.address_te}</p>

            <div class="flex items-center gap-2 mb-5">
              <span class="font-bold text-gray-900 text-sm">{branch.data.phone}</span>
              <span class="text-xs text-gray-400 ml-auto">Mon–Sat, 9AM–7PM</span>
            </div>

            <div class="grid grid-cols-3 gap-2" onclick="event.preventDefault()">
              <a href={`tel:${branch.data.phone.replace(/\s/g, '')}`}
                class="flex items-center justify-center gap-1 bg-red-600 text-white rounded-pill py-2 font-semibold text-xs hover:bg-red-700 transition"
                onclick="event.stopPropagation()">
                 Call
              </a>
              <a href={branch.data.map_link} target="_blank" rel="noopener noreferrer"
                class="flex items-center justify-center gap-1 border border-gray-200 rounded-pill py-2 font-semibold text-xs hover:bg-gray-50 transition text-gray-700"
                onclick="event.stopPropagation()">
                 Directions
              </a>
              <a href={`https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20visit%20Sairam%20Honda%20${encodeURIComponent(branch.data.name_en)}.%20%5BW-BR%5D`}
                target="_blank" rel="noopener noreferrer"
                class="flex items-center justify-center gap-1 bg-white text-[#25D366] border border-gray-200 rounded-pill py-2 font-semibold text-xs hover:border-[#25D366] transition"
                onclick="event.stopPropagation()">
                 WhatsApp
              </a>
            </div>
          </a>
        ))}
      </div>

      <!-- Internal links to branch pages -->
      <div class="mt-8 text-center">
        <p class="text-sm text-gray-500 mb-3">Find your nearest Honda showroom:</p>
        <div class="flex flex-wrap justify-center gap-2">
          {branches.map(b => (
            <a href={`/branches/${b.slug}/`}
              class="text-xs text-red-600 bg-red-50 px-3 py-1 rounded-full hover:bg-red-100 font-semibold transition">
              Honda Showroom {b.data.name_en.replace(' Branch','').replace(' Showroom','')}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- REVIEWS SECTION -->
  <section class="py-16 bg-gray-50 border-t border-gray-100">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-semibold text-gray-900 mb-1">What Our Customers Say</h2>
        <p class="font-noto text-lg text-gray-500 mb-4">మా కస్టమర్ల అభిప్రాయాలు</p>
        <div class="flex items-center justify-center gap-3 mb-1">
          <span class="text-4xl font-semibold text-gray-900">4.0</span>
          <span class="text-gray-500 text-base">/ 5 &nbsp;·&nbsp; <strong class="text-gray-700">1,159+ reviews</strong></span>
        </div>
        <p class="text-gray-500 text-sm">Trusted Honda dealer across <a href="/branches/nizamabad/" class="text-red-600 hover:underline">Nizamabad</a>, <a href="/branches/armoor/" class="text-red-600 hover:underline">Armoor</a>, <a href="/branches/bodhan/" class="text-red-600 hover:underline">Bodhan</a> &amp; 4 more locations</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-5 mb-8">
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
          <div class="text-yellow-400 text-lg mb-2"></div>
          <p class="text-gray-700 text-sm leading-relaxed mb-4">"Good experience from Sairam Honda. Staff is very helpful and the service was smooth."</p>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-red-600 text-white text-xs flex items-center justify-center font-bold">B</div>
            <span class="text-sm font-semibold text-gray-700">B Naveen</span>
          </div>
        </div>
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
          <div class="text-yellow-400 text-lg mb-2"></div>
          <p class="text-gray-700 text-sm leading-relaxed mb-4">"Excellent and good service at Sairam Honda Nizamabad. Highly recommended for Honda bikes and scooters."</p>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-red-600 text-white text-xs flex items-center justify-center font-bold">R</div>
            <span class="text-sm font-semibold text-gray-700">Ravindra Reddy</span>
