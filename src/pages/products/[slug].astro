---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { name_en, name_te, price, whatsapp_message, seo_title, seo_description, featured_image } = entry.data;

const priceNumber = price ? price.replace(/[^0-9]/g, '').slice(0, 8) : undefined;
const waMsg = whatsapp_message || `Hi Sairam Honda, I am interested in ${name_en}. Please share best price.`;
const waLink = `https://wa.me/919666679377?text=${encodeURIComponent(waMsg)}%20%5BW-PD%5D`;

const nextYearEnd = new Date(new Date().getFullYear() + 1, 11, 31).toISOString().slice(0, 10);
const absoluteImage = featured_image?.startsWith('http') ? featured_image : `https://www.sairamhonda.com${featured_image}`;

const productSchema = {
  "@context": "https://schema.org",
  "@type": ["Product", "Vehicle"],
  "@id": `https://www.sairamhonda.com/products/${entry.slug}/`,
  "name": name_en,
  "description": seo_description,
  "image": absoluteImage,
  "brand": { "@type": "Brand", "name": "Honda" },
  "manufacturer": { "@type": "Organization", "name": "Honda Motorcycle & Scooter India" },
  ...(priceNumber ? {
    "offers": {
      "@type": "Offer",
      "priceCurrency": "INR",
      "price": priceNumber,
      "priceValidUntil": nextYearEnd,
      "availability": "https://schema.org/InStock",
      "itemCondition": "https://schema.org/NewCondition",
      "url": `https://www.sairamhonda.com/products/${entry.slug}`,
      "seller": {
        "@type": "AutoDealer",
        "@id": "https://www.sairamhonda.com/#dealer",
        "name": "Sairam Honda",
        "url": "https://www.sairamhonda.com"
      }
    }
  } : {})
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.sairamhonda.com/" },
    { "@type": "ListItem", "position": 2, "name": "All Models", "item": "https://www.sairamhonda.com/products/" },
    { "@type": "ListItem", "position": 3, "name": name_en, "item": `https://www.sairamhonda.com/products/${entry.slug}/` }
  ]
};
---

<Layout title={seo_title} description={seo_description} noOrgSchema={true}>

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="max-w-7xl mx-auto px-4 py-12 pb-32">

    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6 flex items-center gap-2">
      <a href="/" class="text-red-600 hover:underline font-semibold">Honda Showroom Nizamabad</a>
      <span>›</span>
      <a href="/products/" class="text-red-600 hover:underline">All Models</a>
      <span>›</span>
      <span class="text-gray-700 font-medium">{name_en}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Image — wrapped in WhatsApp link to avoid dead clicks -->
      <div>
        <a href={waLink} target="_blank" rel="noopener noreferrer" title={`Get best price on ${name_en}`}>
          <img src={featured_image} alt={`${name_en} — Sairam Honda Nizamabad`}
            class="rounded-2xl shadow-lg w-full object-cover aspect-video hover:opacity-90 transition cursor-pointer" />
        </a>
        <p class="text-xs text-center text-gray-400 mt-2">Tap image to get best price on WhatsApp</p>
      </div>

      <!-- Details -->
      <div>
        <header class="mb-8 border-b border-gray-100 pb-8">
          <h1 class="text-4xl font-semibold tracking-tight text-gray-900">{name_en}</h1>
          <p class="text-2xl text-gray-500 font-noto font-medium mt-2" lang="te">{name_te}</p>

          <div class="mt-6 flex flex-wrap items-center gap-4">
            <span class="text-3xl font-bold text-red-600">{price}</span>
            <span class="text-sm text-gray-400">On-road price, Nizamabad</span>
          </div>
        </header>

        <!-- CTA Buttons — prominent on product page -->
        <div class="space-y-3 mb-8">
          <a href={waLink} target="_blank" rel="noopener noreferrer"
            class="flex items-center justify-center gap-3 w-full bg-[#25D366] text-white px-6 py-4 rounded-pill font-bold text-lg hover:bg-[#20bd5a] transition shadow-lg">
             Get Best Price on WhatsApp
          </a>
          <a href="tel:+918886640573"
            class="flex items-center justify-center gap-3 w-full bg-red-600 text-white px-6 py-4 rounded-pill font-bold text-lg hover:bg-red-700 transition">
             Call Now — 8886640573
          </a>
          <div class="grid grid-cols-2 gap-3">
            <a href={`${waLink.replace('interested in', 'want a test ride for')}`} target="_blank" rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 border border-gray-200 text-black px-4 py-3 rounded-pill font-semibold text-sm hover:border-red-600 transition">
               Book Test Ride
            </a>
            <a href={`${waLink.replace('interested in', 'want EMI details for')}`} target="_blank" rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 border border-gray-200 text-gray-700 px-4 py-3 rounded-pill font-semibold text-sm hover:border-[#25D366] transition">
               Check EMI
            </a>
          </div>
        </div>

        <!-- Quick specs -->
        <div class="bg-gray-50 rounded-xl p-4 mb-6">
          <p class="text-xs font-bold text-gray-500 mb-3">Quick Info</p>
          <div class="grid grid-cols-2 gap-3 text-sm">
            <div><span class="text-gray-500">Dealer:</span> <span class="font-semibold">Sairam Honda</span></div>
            <div><span class="text-gray-500">Location:</span> <span class="font-semibold">Nizamabad</span></div>
            <div><span class="text-gray-500">Branches:</span> <span class="font-semibold">7 across district</span></div>
            <div><span class="text-gray-500">Delivery:</span> <span class="font-semibold">Same day</span></div>
          </div>
        </div>

        <article class="prose max-w-none text-gray-700">
          <Content />
        </article>
      </div>
    </div>

    <!-- Internal links to other products and branches -->
    <div class="mt-16 border-t border-gray-100 pt-10">
      <h3 class="font-bold text-gray-700 mb-4">Other Honda Models at <a href="/" class="text-red-600 hover:underline">Sairam Honda Nizamabad</a>:</h3>
      <div class="flex flex-wrap gap-2">
        {[
          {slug:"activa-125",name:"Activa 125"},{slug:"activa-110",name:"Activa 110"},
          {slug:"shine-125",name:"Shine 125"},{slug:"sp-160",name:"SP 160"},
          {slug:"unicorn",name:"Unicorn"},{slug:"dio-125",name:"Dio 125"},
          {slug:"cb200x",name:"CB200X"},{slug:"hornet-2-0",name:"Hornet 2.0"},
          {slug:"livo",name:"Livo"},{slug:"shine-100",name:"Shine 100"},
        ].filter(b => b.slug !== entry.slug).map(b => (
          <a href={`/products/${b.slug}/`} class="text-xs text-red-600 bg-red-50 px-3 py-1 rounded-full hover:bg-red-100 font-semibold transition">
            Honda {b.name}
          </a>
        ))}
      </div>
      <div class="mt-4 flex flex-wrap gap-4">
        <a href="/products/" class="text-sm text-red-600 font-bold hover:underline"> View all Honda bikes & scooters</a>
        <a href="/service/" class="text-sm text-gray-600 hover:text-red-600 hover:underline font-semibold"> Book service for this bike </a>
      </div>
    </div>
  </main>

  <!-- STICKY BOTTOM CTA BAR — appears on mobile always -->
  <div class="fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-gray-200 shadow-2xl p-3 flex gap-3 sm:hidden">
    <a href="tel:+918886640573"
      class="flex-1 flex items-center justify-center gap-2 bg-red-600 text-white py-3 rounded-xl font-bold text-sm">
       Call
    </a>
    <a href={waLink} target="_blank" rel="noopener noreferrer"
      class="flex-1 flex items-center justify-center gap-2 bg-[#25D366] text-white py-3 rounded-xl font-bold text-sm">
       Get Best Price
    </a>
  </div>

</Layout>
