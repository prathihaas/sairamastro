---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogType?: string;
  noOrgSchema?: boolean;
  preloadImage?: string;
}

const { title, description, canonical, image, ogType, noOrgSchema, preloadImage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head><!-- Google Tag Manager -->
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-TJXW67R9');</script>
<!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#CC0000" />
    <SEOHead title={title} description={description} canonical={canonical} image={image} ogType={ogType} noOrgSchema={noOrgSchema} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+Telugu:wght@400;500;700&display=swap" rel="stylesheet">
  </head>
  <body class="font-sans text-honda-body bg-white selection:bg-red-100 selection:text-red-900 flex flex-col min-h-screen"><!--
  THESIS: A Honda dealer site that reads as Honda. It refuses the local-dealer
  default of loud sale-poster red, drop shadows and 900-weight headings, and
  instead executes HMSI's own corporate identity at dealer scale.
  OWN-WORLD: Honda red #CC0000 used sparingly on pill CTAs only; pure-neutral
  grays (#F7F7F7 ground, #E1E1E1 hairlines, #707070 body, black headings);
  Inter 300-700, never heavier; 24px card corners, 28px pills; zero drop
  shadows; 60px section rhythm. Telugu companion line on every label.
  STORY: A Nizamabad buyer recognises an authorised Honda dealer, finds price,
  branch and EMI fast, and starts a tagged WhatsApp chat.
  FIRST VIEWPORT: White fixed 78px header, wordmark left, red pill Enquire
  right; hero image with a single red pill primary action.
  FORM: Brief-pinned world (honda2wheelersindia.com) — pinned direction beats
  the roll, so no concept seed was drawn.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the
  finish review, the verdict, and DESIGN.md
--><!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TJXW67R9"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
    <Header />
    <slot />
    <Footer />
    
    <!-- Global WhatsApp CTA (Sticky Mobile) -->
    <a href="https://wa.me/919666679377?text=Hi%2C%20I%20want%20to%20enquire%20about%20Honda%202-wheelers.%20%5BW-SH%5D" class="fixed bottom-6 right-6 z-50 bg-[#25D366] text-white p-4 rounded-full shadow-float hover:bg-[#20bd5a] transition-transform hover:scale-105 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
      <span class="font-bold hidden md:inline">Chat With Us</span>
    </a>
      <!-- Lead source tracking: stamps WhatsApp links with traffic source (Google Ads vs Organic). Astro needs is:inline. -->
    <script is:inline>
    (function () {
      try {
        var LS = window.localStorage;
        var qp = new URLSearchParams(location.search);
        function classify() {
          if (LS.getItem('lead_src')) return; // first-touch only
          var gclid = qp.get('gclid') || qp.get('gbraid') || qp.get('wbraid');
          var gad = qp.get('gad_source') || qp.get('gclsrc');
          var um = (qp.get('utm_medium') || '').toLowerCase();
          var us = (qp.get('utm_source') || '').toLowerCase();
          var src = null, g = null;
          if (gclid || gad || um === 'cpc' || um === 'ppc' || um === 'paid') {
            src = 'gads'; if (gclid) g = gclid.slice(0, 512);
          } else if (us === 'google') {
            src = 'org_google';
          } else if (us) {
            src = 'utm_' + us.replace(/[^a-z0-9_]/g, '').slice(0, 16);
          } else {
            var ref = document.referrer || '';
            if (/[.\/]google\./i.test(ref)) src = 'org_google';
            else if (/bing\.|duckduckgo|yahoo\./i.test(ref)) src = 'org_search';
            else if (/facebook|instagram|fb\.|t\.co|twitter|x\.com/i.test(ref)) src = 'social';
            else if (ref && ref.indexOf(location.hostname) === -1) src = 'ref';
            else src = 'direct';
          }
          LS.setItem('lead_src', src);
          if (g) LS.setItem('lead_gclid', g);
          LS.setItem('lead_lp', (location.pathname || '/').slice(0, 40));
        }
        function tagLinks() {
          var s = LS.getItem('lead_src') || 'direct';
          var g = LS.getItem('lead_gclid');
          var tag = ' [wsrc:' + s + (g ? ('|g:' + g) : '') + ']';
          var links = document.querySelectorAll('a[href*="wa.me"], a[href*="api.whatsapp"]');
          for (var i = 0; i < links.length; i++) {
            var a = links[i];
            if (a.getAttribute('data-wsrc')) continue;
            var href = a.getAttribute('href'); if (!href) continue;
            var tm = href.match(/[?&]text=([^&#]*)/);
            var text = 'Hi';
            try { text = tm ? decodeURIComponent(tm[1]) : 'Hi'; } catch (de) {}
            text += tag;
            a.setAttribute('href', 'https://grow.prk.sh/api/wa/click?c=sairam_honda'
              + '&u=' + encodeURIComponent((location.href || '').slice(0, 500))
              + '&s=' + encodeURIComponent(s)
              + (g ? '&gclid=' + encodeURIComponent(g) : '')
              + '&text=' + encodeURIComponent(text));
            a.setAttribute('data-wsrc', '1');
          }
        }
        classify();
        tagLinks();
        document.addEventListener('click', tagLinks, true);   // catch links added after load
        window.addEventListener('load', tagLinks);
      } catch (e) {}
    })();
    </script>

  </body>
</html>

<style is:global>
  .font-sans { font-family: 'Inter', sans-serif; }
  /* Telugu carries matras above and below the baseline. A 1.0 line-height clips
     them, so the companion line always gets its own headroom regardless of the
     leading the surrounding block sets. */
  .font-noto { font-family: 'Noto Sans Telugu', sans-serif; line-height: 1.55; }
  
  /* Markdown content — Honda's type scale and neutrals. */
  .prose h1 { @apply text-h-lg font-semibold text-black mb-4; }
  .prose h2 { @apply text-h-md font-semibold text-black mt-10 mb-4; }
  .prose p { @apply text-base text-gray-600 leading-relaxed mb-4; }
  .prose ul { @apply list-disc list-inside mb-4 space-y-2 text-gray-600; }
  .prose img { @apply rounded-2xl my-8 w-full h-auto; }
</style>
